{
  "name": "ArtCraft Live",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "pip install -r assistant/training/requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "ArtCraft Live site",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "OPENBLAS_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python"
      ]
    },
    "codespaces": {
      "openFiles": [
        "assistant/README.md"
      ]
    }
  }
}
