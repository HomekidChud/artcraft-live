def die(msg):
    print(f"yt-framecraft: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, **kw):
    proc = subprocess.run(cmd, **kw)
    if proc.returncode != 0:
        die(f"command failed ({proc.returncode}): {' '.join(map(str, cmd))}")


def check_tools():
    missing = [t for t in ("ffmpeg", "ffprobe") if shutil.which(t) is None]
    if missing:
        die(f"missing required tools on PATH: {', '.join(missing)}")


# ---------------------------------------------------------------- fetching

def http_json(url, timeout=MIRROR_TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8", "replace"))


def _progress_line(label, got, total):
    pct = f" ({100 * got // total}%)" if total else ""
    sys.stderr.write(f"\r          {label}: {got / 1048576:.1f} MB{pct}   ")
    sys.stderr.flush()


def _stream_to_handle(url, fh, label="", total_hint=0):
    """Stream a URL into an open file handle; returns bytes written."""
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=60) as r:
        got = 0
        last = 0.0
        while True:
            chunk = r.read(1 << 16)
            if not chunk:
                break
            fh.write(chunk)
            got += len(chunk)
            if label and (total_hint and got - last >= total_hint / 20
                         or got - last >= 5 << 20):
                last = got
                _progress_line(label, got, total_hint)
    return got


def http_download(url, dst, label="", connections=4):
    """Download fast: parallel HTTP range connections when the server allows
    it, plain streaming otherwise. Falls back to a single stream if any
    ranged part fails."""
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=60) as r:
        total = int(r.headers.get("Content-Length") or 0)
        can_range = r.headers.get("Accept-Ranges") == "bytes"
    if not (can_range and total > (2 << 20) and connections > 1):
        with open(dst, "wb") as f:
            return _stream_to_handle(url, f, label, total)

    # preallocate the file, then fetch the ranges in parallel
    with open(dst, "wb") as f:
        f.truncate(total)
    nparts = max(2, min(connections, total // (4 << 20)))
    step = total // nparts
    bounds = [(i * step, (i + 1) * step - 1) for i in range(nparts)]
    bounds[-1] = (bounds[-1][0], total - 1)

    got = [0]
    lock = threading.Lock()
    failures = []
    last_seen = [0.0]

    def part(start, end):
        try:
            rq = urllib.request.Request(
                url, headers={"User-Agent": UA, "Range": f"bytes={start}-{end}"})
            with urllib.request.urlopen(rq, timeout=90) as r, open(dst, "r+b") as f:
                if not r.headers.get("Content-Range"):
                    raise RuntimeError("server ignored Range")
                f.seek(start)
                pos = start
                while True:
                    chunk = r.read(1 << 17)
                    if not chunk:
                        break
                    f.write(chunk)
                    pos += len(chunk)
                    with lock:
                        got[0] += len(chunk)
                        if label and got[0] - last_seen[0] >= total / 20:
                            last_seen[0] = got[0]
                            _progress_line(label, got[0], total)
            if pos != end + 1:
                raise RuntimeError(
                    f"range short read ({pos - start}/{end - start + 1})")
        except Exception as e:
            failures.append(str(e)[:120])

    threads = [threading.Thread(target=part, args=(a, b), daemon=True)
               for a, b in bounds]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    if failures or os.path.getsize(dst) != total:
        if label:
            sys.stderr.write("\n")
        print(f"[fetch] ranged download failed — retrying as a single stream")
        with open(dst, "wb") as f:
            return _stream_to_handle(url, f, label)
    if label:
        _progress_line(label, got[0], total)
        sys.stderr.write("\n")
    return total


def race_download(candidates, dst, label):
    """Download from the first of several (mirror, url) candidates to finish.

    Used for the audio track so a slow proxy can't stall the pipeline.
    """
    if len(candidates) <= 1:
        if candidates:
            http_download(candidates[0][1], dst, label, connections=4)
        return
    won = threading.Event()
    winner = [None]

    def worker(i, url):
        tmp = f"{dst}.p{i}"
        try:
            if won.is_set():
                return
            http_download(url, tmp, label if i == 0 else "")
            if not won.is_set():
                won.set()
                winner[0] = tmp
        except Exception:
            pass

    threads = [threading.Thread(target=worker, args=(i, u), daemon=True)
               for i, (_, u) in enumerate(candidates)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    if not won.is_set():
        return
    os.replace(winner[0], dst)
    for i in range(len(candidates)):
        try:
            os.remove(f"{dst}.p{i}")
        except OSError:
            pass


def video_id_from(source):
    m = YT_URL_RE.search(source or "")
    if m:
        return m.group(1)
    if YT_ID_RE.match(source or ""):
        return source
    return None


def _int(v):
    try:
        return int(v or 0)
    except (TypeError, ValueError):
        return 0


def _height(quality):
    m = re.search(r"(\d+)", str(quality or ""))
    return int(m.group(1)) if m else 0


def from_piped(d, base, cap=720):
    """Pick best mp4 video + audio from a Piped /streams response.

    Video height is capped at `cap` by default — a 720p source downloads
    ~3x faster than 1080p and is plenty for AI vision.
    """
    if not isinstance(d, dict) or d.get("error") or not d.get("videoStreams"):
        return None
    mp4 = lambda s: "mp4" in (s.get("mimeType") or "")
    vonly = [s for s in d["videoStreams"] if s.get("videoOnly") and mp4(s)]
    muxed = [s for s in d["videoStreams"] if not s.get("videoOnly") and mp4(s)
             and _height(s.get("quality")) > 0]
    lbry = [s for s in d["videoStreams"] if not s.get("videoOnly") and mp4(s)
            and _height(s.get("quality")) == 0]
    auds = [s for s in (d.get("audioStreams") or []) if mp4(s)]
    best = lambda arr, key: max(arr, key=key) if arr else None
    fit = lambda arr: [s for s in arr if _height(s.get("quality")) <= cap] or arr
    vonly, muxed = fit(vonly), fit(muxed)
    v = best(vonly, key=lambda s: (_height(s.get("quality")), _int(s.get("bitrate"))))
    a = best(auds, key=lambda s: _int(s.get("bitrate")))
    if v and a:
        return {"title": d.get("title"), "duration": d.get("duration"),
                "video": v["url"], "audio": a["url"], "mirror": base}
    m = best(muxed, key=lambda s: (_height(s.get("quality")), _int(s.get("bitrate")))) \
        or (lbry[0] if lbry else None)
    if m:
        return {"title": d.get("title"), "duration": d.get("duration"),
                "video": m["url"], "audio": None, "mirror": base}
    return None


def _fmt_height(f):
    ql = str(f.get("qualityLabel") or f.get("quality") or "")
    m = re.search(r"(\d+)", ql)
    if m:
        return int(m.group(1))
    m = re.match(r"(\d+)x", str(f.get("resolution") or ""))
    return int(m.group(1)) if m else 0


def from_invidious(d, vid, base, cap=720):
    """Pick best mp4 video + audio from an Invidious /api/v1/videos response."""
    if not isinstance(d, dict) or d.get("error"):
        return None
    fmts = d.get("adaptiveFormats") or []
    vids = [f for f in fmts if str(f.get("type") or "").startswith("video/mp4")]
    auds = [f for f in fmts if str(f.get("type") or "").startswith("audio/mp4")]
    lv = lambda itag: f"{base}/latest_version?id={vid}&itag={itag}&local=true"
    if vids:
        fit = [f for f in vids if _fmt_height(f) <= cap] or vids
        v = max(fit, key=lambda f: _int(f.get("bitrate")))
        a = max(auds, key=lambda f: _int(f.get("bitrate"))) if auds else None
        return {"title": d.get("title"), "duration": d.get("lengthSeconds"),
                "video": lv(v["itag"]), "audio": lv(a["itag"]) if a else None,
                "mirror": base}
    muxed = d.get("formatStreams") or []
    if muxed:
        return {"title": d.get("title"), "duration": d.get("lengthSeconds"),
                "video": lv(muxed[0]["itag"]), "audio": None, "mirror": base}
    return None


def try_piped(base, vid, cap=720):
    return from_piped(http_json(f"{base}/streams/{vid}"), base, cap)


def try_invidious(base, vid, cap=720):
    d = http_json(f"{base}/api/v1/videos/{vid}"
                  "?fields=title,lengthSeconds,videoId,adaptiveFormats,formatStreams")
    return from_invidious(d, vid, base, cap)


def resolve_mirrors(vid, only=None, cap=720):
    """Race every mirror in parallel; return a list of workable results,
    fastest-first. The first winner unblocks the download immediately; a
    short grace window collects a few more mirrors so the audio track can
    be raced across them too.

    only: optional base URL to use a single custom mirror (tries both kinds).
    """
    jobs = []
    if only:
        jobs = [(f"piped:{only}", lambda: try_piped(only, vid, cap)),
                (f"invidious:{only}", lambda: try_invidious(only, vid, cap))]
    else:
        jobs += [(f"piped:{b}", lambda b=b: try_piped(b, vid, cap)) for b in PIPED_MIRRORS]
        jobs += [(f"invidious:{b}", lambda b=b: try_invidious(b, vid, cap)) for b in INVIDIOUS_MIRRORS]
    results = []
    with ThreadPoolExecutor(max_workers=len(jobs)) as pool:
        futs = [pool.submit(fn) for _, fn in jobs]
        # wait for the first success (futures self-timeout via MIRROR_TIMEOUT)
        for fut in as_completed(futs):
            try:
                res = fut.result(timeout=MIRROR_TIMEOUT + 6)
            except Exception:
                continue
            if res:
                results.append(res)
                break
        # grace window: scoop up other fast mirrors for the audio race
        if results:
            end = time.time() + 5.0
            for fut in futs:
                if time.time() >= end:
                    break
                try:
                    res = fut.result(timeout=max(0.05, end - time.time()))
                except Exception:
                    continue
                if res:
                    results.append(res)
    return results[:4]


def fetch_via_ytdlp(url, tmpdir):
    out_tmpl = os.path.join(tmpdir, "src.%(ext)s")
    proc = subprocess.run(["yt-dlp", "--no-playlist", "--no-warnings",
                           "-f", "bv*+ba/b", "-o", out_tmpl, url],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        tail = (proc.stderr or "").strip().splitlines()[-1:] or ["unknown error"]
        raise RuntimeError(tail[0][:200])
    files = [f for f in os.listdir(tmpdir)
             if f.startswith("src.") and not f.endswith((".part", ".ytdl"))]
    if not files:
        raise RuntimeError("yt-dlp produced no output file")
    return os.path.join(tmpdir, files[0])


def fetch_via_mirrors(vid, tmpdir, only=None, cap=720, connections=4,
                      no_audio=False):
    print(f"[fetch] racing public mirrors for {vid}…")
    streams = resolve_mirrors(vid, only, cap)
    if not streams:
        raise RuntimeError("every mirror failed (Piped + Invidious)")
    s = streams[0]
    print(f"[fetch] won via {s['mirror']}"
          + (f" — {s['title']}" if s.get("title") else ""))
    vpath = os.path.join(tmpdir, "mirror_vid.mp4")
    apath = None

    # audio downloads concurrently with the video, raced across mirrors
    audio_thread = None
    if not no_audio and s.get("audio"):
        apath = os.path.join(tmpdir, "mirror_aud.m4a")
        cands = [(x["mirror"], x["audio"]) for x in streams[:4] if x.get("audio")]
        audio_thread = threading.Thread(
            target=race_download, args=(cands, apath, "audio"), daemon=True)
        audio_thread.start()
        if len(cands) > 1:
            print(f"[fetch] audio racing across {len(cands)} mirrors")

    http_download(s["video"], vpath, "video", connections)
    if audio_thread is not None:
        audio_thread.join()
        if not os.path.isfile(apath):
            apath = None
            print("[fetch] audio race lost — continuing video-only")

    if apath:
        merged = os.path.join(tmpdir, "merged.mp4")
        run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
             "-i", vpath, "-i", apath, "-c", "copy", "-shortest", merged])
        return merged
    return vpath


def download(source, tmpdir, mirror=None, cap=720, connections=4,
              no_audio=False):
    """Full fetch chain: mirror network first (fast), yt-dlp as fallback."""
    vid = video_id_from(source)
    if not vid:
        die(f"could not extract a YouTube video ID from: {source}")
    try:
        path = fetch_via_mirrors(vid, tmpdir, mirror, cap, connections,
                                 no_audio)
        return path, "mirror network"
    except Exception as e:
        if shutil.which("yt-dlp") is None:
            die(f"mirrors failed and yt-dlp is not installed: {str(e)[:120]}")
        print(f"[fetch] mirrors failed ({str(e)[:80]}…) — trying yt-dlp")
    path = fetch_via_ytdlp(source, tmpdir)
    print(f"[fetch] got {os.path.basename(path)} via yt-dlp")
    return path, "yt-dlp"


# ---------------------------------------------------------------- encode

def probe(path):
    proc = subprocess.run(
        ["ffprobe", "-v", "quiet", "-print_format", "json",
         "-show_streams", "-show_format", path],
        capture_output=True, text=True)
    if proc.returncode != 0:
        die(f"ffprobe could not read {path}")
    data = json.loads(proc.stdout)
    video = next((s for s in data.get("streams", []) if s.get("codec_type") == "video"), None)
    if video is None:
        die(f"no video stream found in {path}")
    num, den = (int(x) for x in video["r_frame_rate"].split("/"))
    fps = num / den if den else 0.0
    if fps <= 0:
        die(f"could not determine source frame rate ({video['r_frame_rate']})")
    fmt = data.get("format", {})
    duration = float(fmt.get("duration", 0) or 0)
    audio = next((s for s in data.get("streams", []) if s.get("codec_type") == "audio"), None)
    return {
        "path": path,
        "width": int(video.get("width", 0)),
        "height": int(video.get("height", 0)),
        "fps": fps,
        "fps_exact": video["r_frame_rate"],
        "duration": duration,
        "has_audio": audio is not None,
        "audio_codec": (audio or {}).get("codec_name"),
        "nb_frames": video.get("nb_frames"),
        "interlaced": (video.get("field_order") or "progressive") not in ("progressive", ""),
    }


def find_font():
    for f in FONT_CANDIDATES:
        if os.path.isfile(f):
            return f
    return None


def even(n):
    return max(2, int(round(n / 2.0)) * 2)


def build_filters(meta, args, fps, font):
    filters = []
    if meta["interlaced"]:
        filters.append("yadif=deint=interlaced")
    filters.append(f"fps={fps}")
    if args.scale and max(meta["width"], meta["height"], 1) > args.scale:
        w, h = meta["width"], meta["height"]
        if w >= h:
            tw, th = args.scale, even(args.scale * h / w)
        else:
            tw, th = even(args.scale * w / h), args.scale
        filters.append(f"scale={tw}:{th}:flags=lanczos")
    if not args.no_burn:
        if font:
            filters.append(
                "drawtext=fontfile='{}':text='f %{{n}}  %{{pts}}s':"
                "x=w-tw-14:y=h-th-14:fontsize=h/26:"
                "fontcolor=white@0.9:box=1:boxcolor=black@0.45:boxborderw=8".format(font))
        else:
            print("[warn] no system font found — skipping frame-number burn-in")
    return filters


def encode(src, dst, meta, args, fps, font):
    filters = build_filters(meta, args, fps, font)
    cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-stats",
           "-i", src]
    if filters:
        cmd += ["-vf", ",".join(filters)]
    gop = max(1, int(math.ceil(fps)))
    cmd += [
        "-c:v", "libx264", "-preset", args.preset, "-crf", str(args.crf),
        "-pix_fmt", "yuv420p", "-profile:v", "high",
        "-g", str(gop), "-keyint_min", str(gop), "-sc_threshold", "0",
        "-force_key_frames", "expr:gte(t,n_forced*1)",
    ]
    if meta["has_audio"]:
        if meta.get("audio_codec") == "aac":
            cmd += ["-c:a", "copy"]   # stream copy: zero re-encode cost
        else:
            cmd += ["-c:a", "aac", "-b:a", "160k"]
    cmd += ["-movflags", "+faststart", dst]
    print(f"[encode] -> {os.path.basename(dst)}  "
          f"(cfr {fps:g} fps, crf {args.crf}, keyframe every 1s)")
    run(cmd)
    return dst


def sidecar(dst, meta, args, fps, source_url, fetched_via):
    out = probe(dst)
    frames = out.get("nb_frames")
    if frames is None:
        frames = int(round(out["duration"] * fps))
    info = {
        "file": os.path.basename(dst),
        "source": source_url or meta["path"],
        "fetched_via": fetched_via,
        "width": out["width"],
        "height": out["height"],
        "fps": fps,
        "frame_count": int(frames),
        "duration_seconds": round(out["duration"], 3),
        "video": "h264 yuv420p",
        "audio": ("copied" if out["has_audio"] and meta.get("audio_codec") == "aac"
                  else ("aac 160k" if out["has_audio"] else "none")),
        "keyframes": "every 1 second (closed GOP)",
        "burned_frame_numbers": not args.no_burn,
        "frame_reference_format": "frame N @ (N / fps) seconds",
    }
    path = dst + ".json"
    with open(path, "w") as fh:
        json.dump(info, fh, indent=2)
    print(f"[sidecar] {os.path.basename(path)}  "
          f"({info['frame_count']} frames @ {fps:g} fps)")


def dump_frames(dst, outdir):
    os.makedirs(outdir, exist_ok=True)
    print(f"[frames] PNG dump -> {outdir}/")
    run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-stats",
         "-i", dst, "-start_number", "0", os.path.join(outdir, "f_%06d.png")])


def contact_sheets(dst, outdir):
    os.makedirs(outdir, exist_ok=True)
    print(f"[grid] contact sheets -> {outdir}/")
    run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error",
         "-i", dst,
         "-vf", "fps=1,scale=320:-2,tile=5x5:padding=4:margin=2:color=black",
         os.path.join(outdir, "grid_%03d.png")])


def main():
    ap = argparse.ArgumentParser(
        prog="yt-framecraft",
        description="Convert any YouTube video (or local file) into a "
                    "frame-perfect MP4 for AI vision.")
    ap.add_argument("source", nargs="?", help="YouTube URL or 11-char video ID")
    ap.add_argument("--file", help="convert a local video file instead")
    ap.add_argument("--mirror", metavar="URL",
                    help="force a single Piped/Invidious mirror base URL "
                         "(skips the parallel race)")
    ap.add_argument("-o", "--output", help="output MP4 path (default: <name>_ai.mp4)")
    ap.add_argument("--fps", type=float, default=None,
                    help="force constant frame rate (default: keep source fps)")
    ap.add_argument("--scale", type=int, default=0, metavar="N",
                    help="cap the long edge at N pixels (e.g. 1280 for vision models)")
    ap.add_argument("--no-burn", action="store_true",
                    help="skip burning frame numbers + timestamps into the video")
    ap.add_argument("--frames", metavar="DIR", help="also export every frame as PNG")
    ap.add_argument("--grid", metavar="DIR", help="also export 5x5 contact sheets (1 sheet/25s)")
    ap.add_argument("--crf", type=int, default=23,
                    help="x264 quality, lower=better (default 23)")
    ap.add_argument("--preset", default="superfast",
                    help="x264 speed preset (default superfast; --hq bumps to crf 18 + medium)")
    ap.add_argument("--hq", action="store_true",
                    help="full-resolution source + crf 18 + medium preset "
                         "(slower, archival quality)")
    ap.add_argument("--connections", type=int, default=4, metavar="N",
                    help="parallel HTTP range connections per stream (default 4)")
    ap.add_argument("--no-audio", action="store_true",
                    help="skip the audio track entirely (pure AI-vision mode)")
    ap.add_argument("--keep-temp", action="store_true", help="keep the intermediate download")
    args = ap.parse_args()

    if not args.source and not args.file:
        ap.error("give a YouTube URL/ID, or use --file <local video>")
    if args.source and args.file:
        ap.error("use either a URL or --file, not both")

    check_tools()
    if args.hq:
        args.crf = min(args.crf, 18)
        if args.preset == "superfast":
            args.preset = "medium"

    source_url = None
    tmpdir = None
    fetched_via = None
    if args.file:
        src = os.path.abspath(args.file)
        if not os.path.isfile(src):
            die(f"file not found: {src}")
    else:
        url = args.source
        if YT_ID_RE.match(url):
            url = f"https://www.youtube.com/watch?v={url}"
        if "youtube.com" in url or "youtu.be" in url:
            source_url = url
        tmpdir = tempfile.mkdtemp(prefix="ytframecraft_")
        cap = 4320 if args.hq else 720
        src, fetched_via = download(url, tmpdir, args.mirror, cap,
                                    args.connections, args.no_audio)

    meta = probe(src)
    fps = args.fps or meta["fps"]
    if args.fps is None:
        print(f"[probe] {meta['width']}x{meta['height']}, "
              f"{fps:.3f} fps ({meta['fps_exact']}), "
              f"{meta['duration']:.1f}s — keeping source rate as CFR")
    else:
        print(f"[probe] source {meta['fps']:.3f} fps -> forcing CFR {fps:g}")

    if args.output:
        dst = os.path.abspath(args.output)
    else:
        stem = os.path.splitext(os.path.basename(src))[0]
        if stem.startswith("src") or stem.startswith("mirror_") or stem == "merged":
            stem = "video"
        dst = os.path.abspath(f"{stem}_ai.mp4")
    if not dst.endswith(".mp4"):
        dst += ".mp4"

    font = find_font()
    encode(src, dst, meta, args, fps, font)
    sidecar(dst, meta, args, fps, source_url, fetched_via)
    if args.frames:
        dump_frames(dst, args.frames)
    if args.grid:
        contact_sheets(dst, args.grid)

    if tmpdir and not args.keep_temp:
        shutil.rmtree(tmpdir, ignore_errors=True)

    print(f"\ndone: {dst}")
    print("open index.html in this repo to inspect it frame by frame")


if __name__ == "__main__":
    main()
